# Which site to test: dev (default) or staging. A TARGET set on the command line or by the
# npm scripts (dev:*, staging:*) overrides this line.
TARGET=dev

BASE_URL=
APP_USERNAME=
APP_PASSWORD=
FRESH_USERNAME=
FRESH_PASSWORD=

# Optional: account for the repeatable SCORM tests (@scorm). Leave empty to use APP_* instead.
# It must never reach the quiz; rotate it if the drift guard fails.
SCORM_USERNAME=
SCORM_PASSWORD=

# Optional: fresh accounts for the account-consuming suite (@scorm-full), each used once.
# Format: user1:pass1;user2:pass2
SCORM_POOL=

# Optional: Manager role account for the Site administration > Reports tests (@manager).
# Leave empty to skip those tests.
MANAGER_USERNAME=
MANAGER_PASSWORD=

# Load-test browser probes (npm run load:probe; see docs/load-test.md). Accounts that do nothing
# else: every probe run Restarts the course. Never the APP account or SCORM_POOL accounts.
# Format: user1:pass1;user2:pass2 (quote the whole value if a password contains #).
LOAD_PROBE_POOL=
# How many probes to run (the first N accounts of LOAD_PROBE_POOL). Empty = all.
LOAD_PROBES=
# k6 virtual-user accounts (npm run load:k6 / load:hybrid). Separate from LOAD_PROBE_POOL, SCORM_POOL
# and the APP account: k6 overwrites their SCORM progress with filler. Ideally one per VU.
LOAD_K6_POOL=
# Probes and k6 refuse any host other than staging. To run them elsewhere on purpose, put that exact
# hostname here, e.g. LOAD_ALLOW_HOST=dev-mvlearn.verificient.com
LOAD_ALLOW_HOST=

# Staging. Used only when TARGET=staging (npm run staging:smoke / staging:regression).
# The values above are dev; these replace them for staging runs.
STAGING_BASE_URL=
STAGING_APP_USERNAME=
STAGING_APP_PASSWORD=
# Optional, same meaning as above; leave empty to use STAGING_APP_* for SCORM tests.
STAGING_SCORM_USERNAME=
STAGING_SCORM_PASSWORD=
STAGING_SCORM_POOL=
# Optional; leave empty to skip the manager tests on staging.
STAGING_MANAGER_USERNAME=
STAGING_MANAGER_PASSWORD=
